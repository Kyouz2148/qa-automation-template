{
  "name": "qa-automation-template",
  "version": "1.0.0",
  "description": "Production-ready Test Automation Template: Playwright (Web + API) + k6 Load Testing + GitHub Actions Sharding & Automated PR Reporting",
  "private": true,
  "scripts": {
    "demo:start": "node demo-app/server.mjs",
    "test": "playwright test",
    "test:web": "playwright test --project=setup --project=web-chromium",
    "test:web:all-browsers": "playwright test --project=setup --project=web-chromium --project=web-firefox --project=web-webkit",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report:html": "playwright show-report reports/html",
    "report:merge": "playwright merge-reports --reporter=html,json ./blob-report",
    "report:pr": "node src/utils/reporters/pr-summary.mjs",
    "k6:smoke": "k6 run k6/scenarios/api-smoke.k6.js",
    "k6:load": "k6 run k6/scenarios/tasks-load.k6.js",
    "k6:stress": "K6_PROFILE=stress k6 run k6/scenarios/tasks-load.k6.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "dotenv": "^18.0.10",
    "eslint": "^9.22.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "zod": "^3.24.2"
  }
}
