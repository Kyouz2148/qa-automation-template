# Target Application URLs
# Leave default to automatically start the built-in demo-app locally.
# Set USE_DEMO_APP=false and point BASE_URL/API_URL to your staging/preview environment.
USE_DEMO_APP=true
BASE_URL=http://127.0.0.1:4173
API_URL=http://127.0.0.1:4173

# Test User Credentials (override via GitHub Actions Secrets in CI)
TEST_USER_EMAIL=qa.engineer@example.com
TEST_USER_PASSWORD=Password123!

# Execution Tuning
CI_WORKERS=2
TEST_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=5000
API_TIMEOUT_MS=10000
